# Bech32 suiprivkey. Create a file on this Mac. Never commit it and never paste it into chat.
# Attacks count for this address. A second wallet does not count for the Walrus session.
SENTINEL_PRIVATE_KEY=

# Optional. Cookie header from a logged-in https://app.redsentinel.xyz tab, used only to store the Walrus record.
# Or set REDSENTINEL_USER_ID if you already know the session user id.
REDSENTINEL_COOKIE=
REDSENTINEL_USER_ID=

# Optional gRPC fullnode. JSON-RPC is not used.
SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443
